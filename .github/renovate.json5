{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  extends: [
    "config:recommended",
    "docker:enableMajor",
    "security:openssf-scorecard",
    ":automergeBranch",
    ":automergeDigest",
    ":automergePatch",
    ":disableRateLimiting",
    ":semanticCommits",
    "github>home-operations/renovate-presets//apps/talosFactory.json5#12.0.0",
    "github>home-operations/renovate-presets//apps/grafanaDashboards.json5#12.0.0",
    "github>neutralalice/home-ops-dev//.github/renovate/autoMerge.json5",
    "github>neutralalice/home-ops-dev//.github/renovate/changelogs.json5",
    "github>neutralalice/home-ops-dev//.github/renovate/customManagers.json5",
    "github>neutralalice/home-ops-dev//.github/renovate/groups.json5",
    "github>neutralalice/home-ops-dev//.github/renovate/labels.json5",
    "github>neutralalice/home-ops-dev//.github/renovate/semanticCommits.json5",
    "github>neutralalice/home-ops-dev//.github/renovate/manual.json5",
  ],
  dependencyDashboard: {
    autoclose: true,
    title: "Renovate Dashboard",
  },
  minimumReleaseAge: "3 days",
  vulnerabilityAlerts: {
    minimumReleaseAge: "1 days",
  },
  enabledManagers: [
    "flux",
    "github-actions",
    "helm-values",
    "helmfile",
    "kubernetes",
    "mise",
    "renovate-config",
    "custom.regex",
  ],
  suppressNotifications: ["prEditedNotification", "prIgnoreNotification"],
  flux: {
    managerFilePatterns: ["/\\.ya?ml(?:\\.j2)?$/"],
  },
  "helm-values": {
    managerFilePatterns: [
      "/(^|/)values\\.ya?ml(?:\\.j2)?$/",
      "/(^|/)helmrelease\\.ya?ml(?:\\.j2)?$/",
      "/(^|/)helm-release\\.ya?ml(?:\\.j2)?$/",
      "/(^|/)hr\\.ya?ml(?:\\.j2)?$/",
    ],
  },
  helmfile: {
    managerFilePatterns: [
      "/(^|/)helmfile\\.ya?ml(?:\\.gotmpl)?(?:\\.j2)?$/",
      "/(^|/)helmfile\\.d/.+\\.ya?ml(?:\\.gotmpl)?(?:\\.j2)?$/",
    ],
  },
  kubernetes: {
    managerFilePatterns: ["/\\.ya?ml(?:\\.j2)?$/"],
  },
  kustomize: {
    managerFilePatterns: ["/(^|/)kustomization\\.ya?ml(?:\\.j2)?$/"],
  },
}

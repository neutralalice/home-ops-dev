---
apiVersion: v1alpha1
kind: HostnameConfig
hostname: k8s-02
---
apiVersion: v1alpha1
kind: LinkAliasConfig
name: ethSel0
selector:
  match: glob("48:21:0b:3d:9e:f9", mac(link.hardware_addr))
---
apiVersion: v1alpha1
kind: LinkAliasConfig
name: ethSel1
selector:
  match: glob("1-1.0", link.bus_path) && glob("thunderbolt-net", link.driver)
---
apiVersion: v1alpha1
kind: LinkAliasConfig
name: ethSel2
selector:
  match: glob("0-1.0", link.bus_path) && glob("thunderbolt-net", link.driver)
---
apiVersion: v1alpha1
kind: LinkConfig
name: ethSel0
addresses:
  - address: fdca:fec0:ffee:69::12/64
---
apiVersion: v1alpha1
kind: LinkConfig
name: ethSel1
mtu: 65520
addresses:
  - address: 169.254.255.12/32
  - address: fd69:b19:b00b:cafe::12/128
routes:
  - destination: 169.254.255.11/32
    source: 169.254.255.12
    metric: 2048
  - destination: fd69:b19:b00b:cafe::11/128
    source: fd69:b19:b00b:cafe::12
    metric: 2048
---
apiVersion: v1alpha1
kind: LinkConfig
name: ethSel2
mtu: 65520
addresses:
  - address: 169.254.255.12/32
  - address: fd69:b19:b00b:cafe::12/128
routes:
  - destination: 169.254.255.13/32
    source: 169.254.255.12
    metric: 2048
  - destination: fd69:b19:b00b:cafe::13/128
    source: fd69:b19:b00b:cafe::12
    metric: 2048
